datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output = "./src/generated/"
}

model User {
  id        Int      @id             @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
